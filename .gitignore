# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 撮影データの元ファイル（大容量。サイトには public/images/ の縮小版を使う）
/佐々木設備HP撮影/

# 支給資料の元ファイル（公開リポジトリには入れない。ロゴは assets/logo-source.jpg に取り込み済み）
/*.pdf
/*.jpg
/*.zip
/*.png
