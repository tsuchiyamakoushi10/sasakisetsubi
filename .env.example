# 公開URL（ドメイン確定後に変更。末尾スラッシュなし）
NEXT_PUBLIC_SITE_URL=https://sasakisetsubi.vercel.app

# Resend（Vercel の環境変数に設定。コードに直書きしない）
RESEND_API_KEY=
MAIL_FROM=株式会社佐々木設備 <noreply@sasakisetsubi.com>
MAIL_TO=sasakisetsubi912@gmail.com

# Google アナリティクス 4（本番だけで計測。入れるとプライバシーポリシーに GA の記載が自動で出る）
NEXT_PUBLIC_GA_ID=

# Search Console の HTML タグ確認用（DNS で確認するなら不要）
GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile（両方入れるとフォームのロボット判定が有効になる）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# sitemap の lastmod を git の履歴から取るため（Vercel に設定）
VERCEL_DEEP_CLONE=true
